{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moon-ai-skills.dev/schemas/conversation-summary.json",
  "title": "ConversationSummary",
  "description": "Structured knowledge extracted from a conversation, used to render visual HTML decision briefs.",
  "type": "object",
  "required": ["title", "summary", "topics", "decisions", "actionItems", "openQuestions"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Short, descriptive title of the conversation topic."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Executive summary of the discussion, main goals, and outcomes."
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "description": "Key topics discussed during the session.",
      "items": {
        "type": "object",
        "required": ["name", "insight"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Name of the topic."
          },
          "insight": {
            "type": "string",
            "minLength": 1,
            "description": "Key takeaway or technical insight."
          },
          "status": {
            "type": "string",
            "enum": ["resolved", "ongoing", "postponed"],
            "description": "Resolution status of the topic."
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "description": "Design or technical decisions made during the conversation.",
      "items": {
        "type": "object",
        "required": ["decision", "reason"],
        "additionalProperties": false,
        "properties": {
          "decision": {
            "type": "string",
            "minLength": 1,
            "description": "What was decided."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Rationale or trade-off analysis behind the decision."
          },
          "status": {
            "type": "string",
            "description": "E.g., approved, proposed, active."
          }
        }
      }
    },
    "actionItems": {
      "type": "array",
      "description": "Follow-up tasks, assignments, and action items.",
      "items": {
        "type": "object",
        "required": ["task", "owner", "priority"],
        "additionalProperties": false,
        "properties": {
          "task": {
            "type": "string",
            "minLength": 1,
            "description": "Description of the work to be done."
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "description": "Person or role assigned to the task."
          },
          "priority": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "description": "Task priority level."
          },
          "dueDate": {
            "type": "string",
            "description": "Optional deadline or milestone."
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "description": "Unresolved questions or issues that require further investigation.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolvedConflicts": {
      "type": "array",
      "description": "Detected disagreements, alternative proposals, or conflicting constraints that remain active.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata about the generated summary.",
      "properties": {
        "skillName": {
          "type": "string",
          "description": "Name of the skill that generated this summary."
        },
        "skillVersion": {
          "type": "string",
          "description": "Version of the skill."
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the summary was generated."
        }
      },
      "additionalProperties": false
    }
  }
}
